{
  "name": "mantis-head-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "model:build": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/build_head.py -- public/models/mantis-head.glb",
    "model:check": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/check_proportions.py -- public/models/mantis-head.glb assets-src/reference/calibration.json",
    "reference:build": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/build_reference.py -- assets-src/reference/mantis-reference-sheet.png assets-src/reference/calibration.json public/reference"
  },
  "dependencies": {
    "camera-controls": "^3.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
