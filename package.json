{
  "name": "mantis-head-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "model:build": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/build_head.py -- assets-src/models/mantis-head.raw.glb && gltf-transform meshopt assets-src/models/mantis-head.raw.glb public/models/mantis-head.glb && npm run textures:build",
    "textures:build": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/bake_maps.py -- assets-src/models/mantis-head.raw.glb assets-src/textures public/textures",
    "model:check": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/check_proportions.py -- assets-src/models/mantis-head.raw.glb assets-src/reference/calibration.json",
    "model:silhouette": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/check_silhouette.py -- assets-src/models/mantis-head.raw.glb assets-src/reference/calibration.json assets-src/reference/mantis-reference-sheet.png test-results/silhouette",
    "reference:build": "blender -b --factory-startup --python-exit-code 1 --python tools/blender/build_reference.py -- assets-src/reference/mantis-reference-sheet.png assets-src/reference/calibration.json public/reference",
    "test:visual": "playwright test --project=desktop-chromium",
    "test:ios": "playwright test --project=iphone-webkit"
  },
  "dependencies": {
    "camera-controls": "^3.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
